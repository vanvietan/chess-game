{
  "version": 2,
  "builds": [
    {
      "src": "./main.go",
      "use": "@vercel/go"
    },
    {
      "src": "./index.html",
      "use": "@vercel/static"
    },
    {
      "src": "./frontend.js",
      "use": "@vercel/static"
    },
    {
      "src": "./styles.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/main.go"
    },
    {
      "src": "/(.*\\.(js|css|html|png|jpg|svg|ico))",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "env": {
    "GIN_MODE": "release",
    "USE_CHESS_API": "true",
    "CHESS_API_URL": "https://chess-api.com/v1"
  }
}
