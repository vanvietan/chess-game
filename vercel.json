{
  "functions": {
    "api/*.go": {
      "runtime": "@vercel/go"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/handler.go"
    },
    {
      "src": "/(.*\\.(js|css|html|png|jpg|svg|ico))",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "env": {
    "GIN_MODE": "release",
    "USE_CHESS_API": "true",
    "CHESS_API_URL": "https://chess-api.com/v1"
  }
}
